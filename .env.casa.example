DOMAIN=change-me.tailnet-name.ts.net
# Required by docker-compose.prod.yml; unused here, because Tailscale provides the certificate.
ACME_EMAIL=unused@example.com

POSTGRES_USER=bis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bis

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=Bis <change-me@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BACKUP_DIR=/Users/change-me/BisBackup
RESTIC_REPOSITORY=/backup/repo
RESTIC_PASSWORD=change-me
BACKUP_HOUR_UTC=3
BACKUP_PING_URL=
