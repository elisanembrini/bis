    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "storybook": "10.6.3",
