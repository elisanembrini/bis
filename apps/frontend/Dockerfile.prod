FROM node:24.22.2-alpine AS build

RUN corepack enable

WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json ./apps/frontend/
COPY e2e/package.json ./e2e/

RUN pnpm install --frozen-lockfile --filter bis-frontend...

COPY apps/frontend ./apps/frontend

WORKDIR /repo/apps/frontend

RUN pnpm build

FROM caddy:2.11.7-alpine AS runtime

RUN addgroup -S -g 10001 bis \
    && adduser -S -u 10001 -G bis -H -s /sbin/nologin bis \
    && mkdir -p /srv /data /config \
    && chown -R bis:bis /srv /data /config

COPY --from=build --chown=bis:bis /repo/apps/frontend/dist /srv
COPY --chown=bis:bis deploy/Caddyfile deploy/Caddyfile.site /etc/caddy/

USER bis:bis

EXPOSE 80 443
