  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_CREDENTIALS",
          "TOO_MANY_ATTEMPTS",
          "EMAIL_ALREADY_REGISTERED",
          "RESET_TOKEN_INVALID",
          "UNAUTHENTICATED",
          "GOOGLE_UNAVAILABLE",
          "GOOGLE_STATE_INVALID",
          "GOOGLE_CANCELLED",
          "GOOGLE_EMAIL_NOT_VERIFIED",
          "GOOGLE_ACCOUNT_CONFLICT",
          "GOOGLE_FAILED",
          "INVITE_NOT_FOUND",
          "INVITE_EXPIRED",
          "INVITE_USED",
          "ALREADY_IN_HOUSEHOLD",
          "MUST_LEAVE_HOUSEHOLD",
          "OWNER_CANNOT_LEAVE",
          "NOT_HOUSEHOLD_OWNER",
          "MEMBER_NOT_FOUND",
          "CANNOT_REMOVE_SELF"
        ],
        "title": "ErrorCode"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "ForgotPasswordRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ForgotPasswordRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "HouseholdMemberResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role"
          },
          "joined_at": {
            "type": "string",
            "format": "date-time",
            "title": "Joined At"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "display_name",
          "role",
          "joined_at"
        ],
        "title": "HouseholdMemberResponse"
      },
      "HouseholdResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/HouseholdMemberResponse"
            },
            "type": "array",
            "title": "Members"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "members"
        ],
        "title": "HouseholdResponse"
      },
      "HouseholdSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "title": "HouseholdSummary"
      },
      "InviteCreatedResponse": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "url",
          "expires_at"
        ],
        "title": "InviteCreatedResponse"
      },
      "InvitePreviewResponse": {
        "properties": {
          "household_id": {
            "type": "string",
            "format": "uuid",
            "title": "Household Id"
          },
          "inviter_display_name": {
            "type": "string",
            "title": "Inviter Display Name"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "household_id",
          "inviter_display_name",
          "expires_at"
        ],
        "title": "InvitePreviewResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "household": {
            "$ref": "#/components/schemas/HouseholdSummary"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "household"
        ],
        "title": "MeResponse"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name"
          },
          "invite_token": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
